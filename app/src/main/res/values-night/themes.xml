        <item name="colorPrimary">@color/calc_accent</item>
        <item name="colorPrimaryDark">@color/calc_background</item>
        <item name="colorAccent">@color/calc_accent</item>
        <item name="android:windowBackground">@color/calc_background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
