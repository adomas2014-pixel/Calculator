<?xml version="1.0" encoding="utf-8"?>
<!-- One memory item: value, then MC / M+ / M- for that item. Tap the item to recall it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_subtle_button"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/memory_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/selawksb"
        android:textColor="@color/calc_text_primary"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/memory_item_clear"
            style="@style/CalcPanelMiniButton"
            android:text="@string/btn_memory_clear" />

        <Button
            android:id="@+id/memory_item_add"
            style="@style/CalcPanelMiniButton"
            android:text="@string/btn_memory_add" />

        <Button
            android:id="@+id/memory_item_subtract"
            style="@style/CalcPanelMiniButton"
            android:text="@string/btn_memory_subtract" />
    </LinearLayout>
</LinearLayout>
