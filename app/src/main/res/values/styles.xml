<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Header "Standard" -->
    <style name="CalcHeaderTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/calc_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/selawksb</item>
        <item name="fontFamily">@font/selawksb</item>
    </style>

    <!-- Small expression line above the result -->
    <style name="CalcExpression">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">start</item>
        <item name="android:textColor">@color/calc_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/selawk</item>
        <item name="fontFamily">@font/selawk</item>
    </style>

    <!-- Big result display; shrinks to fit long numbers -->
    <style name="CalcDisplay">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/calc_text_primary</item>
        <item name="android:textSize">46sp</item>
        <item name="android:fontFamily">@font/selawksb</item>
        <item name="fontFamily">@font/selawksb</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">18sp</item>
        <item name="autoSizeMaxTextSize">46sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- Memory row buttons (MC MR M+ M- MS M˅) -->
    <style name="CalcMemoryButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/bg_subtle_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/calc_key_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/selawksb</item>
        <item name="fontFamily">@font/selawksb</item>
    </style>

    <!-- Keypad rows and keys -->
    <style name="CalcKeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CalcKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/calc_key_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/selawk</item>
        <item name="fontFamily">@font/selawk</item>
        <item name="android:background">@drawable/bg_key_function</item>
    </style>

    <style name="CalcKey.Number">
        <item name="android:background">@drawable/bg_key_number</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/selawksb</item>
        <item name="fontFamily">@font/selawksb</item>
    </style>

    <style name="CalcKey.Equals">
        <item name="android:background">@drawable/bg_key_equals</item>
        <item name="android:textColor">@color/calc_on_accent</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CalcKey.Icon">
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Header icon buttons -->
    <style name="CalcHeaderIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_subtle_button</item>
    </style>

    <!-- Small MC / M+ / M- buttons on each memory item -->
    <style name="CalcPanelMiniButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_key_function</item>
        <item name="android:textColor">@color/calc_key_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/selawksb</item>
        <item name="fontFamily">@font/selawksb</item>
    </style>
</resources>
